# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB: use one local or Atlas value, not both.
MONGODB_URI=mongodb://localhost:27017/mentorlink
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/mentorlink?retryWrites=true&w=majority

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Allowed institute email domains
ALLOWED_DOMAINS=spit.ac.in,yourinstitute.ac.in

# Optional email configuration
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_user
# SMTP_PASS=replace_with_smtp_password
# EMAIL_FROM="MentorLink <no-reply@example.com>"

# Optional local Atlas troubleshooting only; do not use in production.
# ATLAS_TLS_INSECURE=1

# Optional uploads location
# UPLOADS_DIR=

# Optional first-admin bootstrap values
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_local_bootstrap_password
BOOTSTRAP_ADMIN_DEPARTMENT=CSE

# Optional Python recommendation service integration.
# If omitted, Express uses the existing JavaScript recommendation engine.
# RECOMMENDATION_SERVICE_URL=http://127.0.0.1:8000
# RECOMMENDATION_ENGINE_VERSION=v1
# RECOMMENDATION_SERVICE_TIMEOUT_MS=15000
# DEMO_RECOMMENDATIONS=false
